{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smyklot.com/schema/workspace-panel-v1.json",
  "title": "Smyklot workspace configuration with panel settings",
  "description": "Command and panel settings synchronized with this workspace when configuration file sync is enabled in the panel. Access and connection permissions stay in the panel.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "allow_draft_merges": {
      "type": "boolean",
      "description": "Lets a merge command mark a draft pull request ready for review before continuing. Off by default: drafts stay protected until a person explicitly publishes them",
      "default": false
    },
    "allow_self_approval": {
      "type": "boolean",
      "description": "Lets the author of a pull request approve it. Off by default: an approval is meant to be a second pair of eyes",
      "default": false
    },
    "allowed_commands": {
      "type": "array",
      "description": "Narrows what may be run. An empty list allows every command; naming any command forbids the rest",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "command_aliases": {
      "type": "object",
      "description": "Maps a spelling somebody uses onto the command it means, such as \"app\" onto \"approve\"",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "command_prefix": {
      "type": "string",
      "description": "Opens a slash-style command, as \"/\" does in \"/approve\"",
      "default": "/"
    },
    "disable_bare_commands": {
      "type": "boolean",
      "description": "Stops Smyklot answering an unprefixed word such as \"approve\" or \"lgtm\" on a line of its own",
      "default": false
    },
    "disable_deleted_comments": {
      "type": "boolean",
      "description": "Stops Smyklot reporting that a comment carrying a command was deleted",
      "default": false
    },
    "disable_mentions": {
      "type": "boolean",
      "description": "Stops Smyklot answering a mention, such as \"@smyklot approve\"",
      "default": false
    },
    "disable_reactions": {
      "type": "boolean",
      "description": "Stops a reaction on the pull request body counting as a command at all",
      "default": false
    },
    "disable_unapprove": {
      "type": "boolean",
      "description": "Withdraws the unapprove and disapprove commands",
      "default": false
    },
    "formatting": {
      "type": "object",
      "description": "Controls file presentation independently of semantic merge. Every dimension defaults to preserve, so adding the feature does not rewrite an existing template",
      "additionalProperties": false,
      "properties": {
        "common": {
          "type": "object",
          "description": "Applies to all supported file formats",
          "additionalProperties": false,
          "properties": {
            "final_newline": {
              "type": "string",
              "description": "Inserts, removes, or preserves the last line ending",
              "enum": [
                "preserve",
                "insert",
                "remove"
              ],
              "default": "preserve"
            },
            "indent_style": {
              "type": "string",
              "description": "Chooses spaces, tabs, or the document's existing indentation",
              "enum": [
                "preserve",
                "spaces",
                "tabs"
              ],
              "default": "preserve"
            },
            "indent_width": {
              "type": "integer",
              "description": "Sets the number of spaces per indentation level",
              "minimum": 1,
              "maximum": 16,
              "default": 2
            },
            "inline_max_chars": {
              "type": "integer",
              "description": "Limits automatically inlined collections by rendered characters; zero uses only line width",
              "minimum": 0,
              "maximum": 320,
              "default": 0
            },
            "line_ending": {
              "type": "string",
              "description": "Chooses LF, CRLF, or the document's existing endings",
              "enum": [
                "preserve",
                "lf",
                "crlf"
              ],
              "default": "preserve"
            },
            "line_width": {
              "type": "integer",
              "description": "Sets the target line length for automatic wrapping",
              "minimum": 40,
              "maximum": 320,
              "default": 100
            }
          },
          "default": {
            "final_newline": "preserve",
            "indent_style": "preserve",
            "indent_width": 2,
            "inline_max_chars": 0,
            "line_ending": "preserve",
            "line_width": 100
          }
        },
        "json": {
          "type": "object",
          "description": "Controls how JSON files are written",
          "additionalProperties": false,
          "properties": {
            "arrays": {
              "type": "string",
              "description": "Controls JSON array layout",
              "enum": [
                "preserve",
                "auto",
                "compact",
                "expanded"
              ],
              "default": "preserve"
            },
            "key_order": {
              "type": "string",
              "description": "Preserves insertion order or sorts object keys",
              "enum": [
                "preserve",
                "sort"
              ],
              "default": "preserve"
            },
            "objects": {
              "type": "string",
              "description": "Controls JSON object layout",
              "enum": [
                "preserve",
                "auto",
                "compact",
                "expanded"
              ],
              "default": "preserve"
            }
          },
          "default": {
            "arrays": "preserve",
            "key_order": "preserve",
            "objects": "preserve"
          }
        },
        "jsonc": {
          "type": "object",
          "description": "Controls formatting for JSON files with comments",
          "additionalProperties": false,
          "properties": {
            "trailing_commas": {
              "type": "string",
              "description": "Inserts, removes, or preserves JSONC trailing commas",
              "enum": [
                "preserve",
                "insert",
                "remove"
              ],
              "default": "preserve"
            }
          },
          "default": {
            "trailing_commas": "preserve"
          }
        },
        "markdown": {
          "type": "object",
          "description": "Controls how Markdown files are written",
          "additionalProperties": false,
          "properties": {
            "list_spacing": {
              "type": "string",
              "description": "Makes safe lists tight or loose, or preserves their spacing",
              "enum": [
                "preserve",
                "tight",
                "loose"
              ],
              "default": "preserve"
            },
            "prose_wrap": {
              "type": "string",
              "description": "Wraps safe prose, removes soft wraps, or preserves it",
              "enum": [
                "preserve",
                "always",
                "never"
              ],
              "default": "preserve"
            },
            "tables": {
              "type": "string",
              "description": "Aligns or compacts safe GFM tables, or preserves them",
              "enum": [
                "preserve",
                "align",
                "compact"
              ],
              "default": "preserve"
            }
          },
          "default": {
            "list_spacing": "preserve",
            "prose_wrap": "preserve",
            "tables": "preserve"
          }
        },
        "preset": {
          "type": "string",
          "description": "Sets a starting style before individual settings are applied",
          "enum": [
            "preserve",
            "conventional"
          ],
          "default": "preserve"
        },
        "toml": {
          "type": "object",
          "description": "Controls how TOML files are written",
          "additionalProperties": false,
          "properties": {
            "align_comments": {
              "type": "string",
              "description": "Aligns or compacts neighbouring TOML comments",
              "enum": [
                "preserve",
                "align",
                "compact"
              ],
              "default": "preserve"
            },
            "align_entries": {
              "type": "string",
              "description": "Aligns or compacts neighbouring TOML assignments",
              "enum": [
                "preserve",
                "align",
                "compact"
              ],
              "default": "preserve"
            },
            "arrays": {
              "type": "string",
              "description": "Controls TOML array layout",
              "enum": [
                "preserve",
                "auto",
                "compact",
                "expanded"
              ],
              "default": "preserve"
            },
            "key_order": {
              "type": "string",
              "description": "Preserves insertion order or sorts TOML keys",
              "enum": [
                "preserve",
                "sort"
              ],
              "default": "preserve"
            },
            "quote_style": {
              "type": "string",
              "description": "Chooses a quote style where the string can stay unchanged",
              "enum": [
                "preserve",
                "prefer_basic",
                "prefer_literal"
              ],
              "default": "preserve"
            },
            "trailing_commas": {
              "type": "string",
              "description": "Controls commas in multiline TOML arrays",
              "enum": [
                "preserve",
                "multiline",
                "remove"
              ],
              "default": "preserve"
            }
          },
          "default": {
            "align_comments": "preserve",
            "align_entries": "preserve",
            "arrays": "preserve",
            "key_order": "preserve",
            "quote_style": "preserve",
            "trailing_commas": "preserve"
          }
        },
        "yaml": {
          "type": "object",
          "description": "Controls how YAML files are written",
          "additionalProperties": false,
          "properties": {
            "document_start": {
              "type": "string",
              "description": "Inserts, removes, or preserves the YAML document marker",
              "enum": [
                "preserve",
                "insert",
                "remove"
              ],
              "default": "preserve"
            },
            "mappings": {
              "type": "string",
              "description": "Controls YAML mapping layout",
              "enum": [
                "preserve",
                "auto",
                "flow",
                "block"
              ],
              "default": "preserve"
            },
            "quote_style": {
              "type": "string",
              "description": "Chooses a quote style where the value can stay unchanged",
              "enum": [
                "preserve",
                "prefer_plain",
                "prefer_single",
                "prefer_double"
              ],
              "default": "preserve"
            },
            "sequence_indent": {
              "type": "string",
              "description": "Controls indentation of block sequence markers",
              "enum": [
                "preserve",
                "indented",
                "indentless"
              ],
              "default": "preserve"
            },
            "sequences": {
              "type": "string",
              "description": "Controls YAML sequence layout",
              "enum": [
                "preserve",
                "auto",
                "flow",
                "block"
              ],
              "default": "preserve"
            }
          },
          "default": {
            "document_start": "preserve",
            "mappings": "preserve",
            "quote_style": "preserve",
            "sequence_indent": "preserve",
            "sequences": "preserve"
          }
        }
      },
      "default": {
        "common": {
          "final_newline": "preserve",
          "indent_style": "preserve",
          "indent_width": 2,
          "inline_max_chars": 0,
          "line_ending": "preserve",
          "line_width": 100
        },
        "json": {
          "arrays": "preserve",
          "key_order": "preserve",
          "objects": "preserve"
        },
        "jsonc": {
          "trailing_commas": "preserve"
        },
        "markdown": {
          "list_spacing": "preserve",
          "prose_wrap": "preserve",
          "tables": "preserve"
        },
        "preset": "preserve",
        "toml": {
          "align_comments": "preserve",
          "align_entries": "preserve",
          "arrays": "preserve",
          "key_order": "preserve",
          "quote_style": "preserve",
          "trailing_commas": "preserve"
        },
        "yaml": {
          "document_start": "preserve",
          "mappings": "preserve",
          "quote_style": "preserve",
          "sequence_indent": "preserve",
          "sequences": "preserve"
        }
      }
    },
    "panel": {
      "type": "object",
      "description": "Versioned panel settings for this scope",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "workspace"
          ]
        },
        "settings": {
          "type": "object",
          "description": "Workspace defaults for repositories without their own overrides",
          "additionalProperties": false,
          "properties": {
            "file_index_interval": {
              "type": "string",
              "description": "A nonnegative whole-second duration, for example 30s, 2m or 1h. Omit to inherit."
            },
            "merge_exceptions": {
              "type": "object",
              "description": "Merge protection exceptions. Omit to preserve existing exceptions or inherit workspace defaults.",
              "additionalProperties": false,
              "properties": {
                "actors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "description": "A GitHub ruleset bypass actor",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "integer",
                        "description": "GitHub actor ID. Omit for organization administrators and deploy keys.",
                        "minimum": 0
                      },
                      "mode": {
                        "type": "string",
                        "enum": [
                          "always",
                          "pull_request",
                          "exempt"
                        ]
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "Integration",
                          "Team",
                          "RepositoryRole",
                          "OrganizationAdmin",
                          "User",
                          "DeployKey"
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "mode"
                    ],
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "Integration",
                              "Team",
                              "RepositoryRole",
                              "User"
                            ]
                          }
                        },
                        "required": [
                          "id"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "OrganizationAdmin"
                            ]
                          }
                        }
                      },
                      {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "enum": [
                              "always",
                              "exempt"
                            ]
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "DeployKey"
                            ]
                          }
                        }
                      }
                    ]
                  }
                },
                "allow": {
                  "type": "boolean",
                  "description": "Allow these actors to bypass merge protection"
                }
              }
            },
            "merge_mode": {
              "type": "string",
              "enum": [
                "checks",
                "labels"
              ]
            },
            "protected_refs": {
              "type": "object",
              "description": "Branches where merge protection applies",
              "additionalProperties": false,
              "properties": {
                "exclude": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "include": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "include"
              ]
            },
            "quiet_period": {
              "type": "string",
              "description": "A nonnegative whole-second duration, for example 30s, 2m or 1h. Omit to inherit."
            },
            "repository_default_enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "repository_default_enabled",
            "merge_mode",
            "protected_refs"
          ]
        },
        "sync": {
          "type": "object",
          "description": "Shared configurations. Omit a kind to remove its settings at this scope.",
          "additionalProperties": false,
          "properties": {
            "files": {
              "type": "object",
              "description": "Shared files configuration",
              "additionalProperties": false,
              "properties": {
                "document": {
                  "type": "string",
                  "description": "A JSON object written as a TOML string. Multiline literal strings preserve null values and file contents. The configuration is validated before import.",
                  "contentMediaType": "application/json"
                },
                "enabled": {
                  "type": "boolean",
                  "description": "Whether this configuration is synchronized"
                }
              },
              "required": [
                "document",
                "enabled"
              ]
            },
            "labels": {
              "type": "object",
              "description": "Shared labels configuration",
              "additionalProperties": false,
              "properties": {
                "document": {
                  "type": "string",
                  "description": "A JSON object written as a TOML string. Multiline literal strings preserve null values and file contents. The configuration is validated before import.",
                  "contentMediaType": "application/json"
                },
                "enabled": {
                  "type": "boolean",
                  "description": "Whether this configuration is synchronized"
                }
              },
              "required": [
                "document",
                "enabled"
              ]
            },
            "rulesets": {
              "type": "object",
              "description": "Shared rulesets configuration",
              "additionalProperties": false,
              "properties": {
                "document": {
                  "type": "string",
                  "description": "A JSON object written as a TOML string. Multiline literal strings preserve null values and file contents. The configuration is validated before import.",
                  "contentMediaType": "application/json"
                },
                "enabled": {
                  "type": "boolean",
                  "description": "Whether this configuration is synchronized"
                }
              },
              "required": [
                "document",
                "enabled"
              ]
            },
            "settings": {
              "type": "object",
              "description": "Shared settings configuration",
              "additionalProperties": false,
              "properties": {
                "document": {
                  "type": "string",
                  "description": "A JSON object written as a TOML string. Multiline literal strings preserve null values and file contents. The configuration is validated before import.",
                  "contentMediaType": "application/json"
                },
                "enabled": {
                  "type": "boolean",
                  "description": "Whether this configuration is synchronized"
                }
              },
              "required": [
                "document",
                "enabled"
              ]
            }
          }
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        }
      },
      "required": [
        "version",
        "scope",
        "settings"
      ]
    },
    "quiet_pending": {
      "type": "boolean",
      "description": "Drops the comment announcing that a merge is waiting on CI, leaving only its reaction",
      "default": false
    },
    "quiet_reactions": {
      "type": "boolean",
      "description": "Drops the comment an approval or merge driven by a reaction would post",
      "default": false
    },
    "quiet_success": {
      "type": "boolean",
      "description": "Drops the comment a successful command would post, leaving only its reaction. Errors and warnings still comment",
      "default": false
    }
  },
  "required": [
    "panel"
  ]
}
