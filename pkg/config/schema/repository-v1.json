{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smyklot.com/schema/repository-v1.json",
  "title": "Smyklot repository configuration",
  "description": "Settings a repository may set for Smyklot, in .smyklot.toml, .smyklot/config.toml, .github/.smyklot.toml or the legacy .github/smyklot.yaml.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "allow_draft_merges": {
      "type": "boolean",
      "description": "Lets a merge command mark a draft pull request ready for review before continuing. Off by default: drafts stay protected until a person explicitly publishes them.",
      "default": false
    },
    "allow_self_approval": {
      "type": "boolean",
      "description": "Lets the author of a pull request approve it. Off by default: an approval is meant to be a second pair of eyes.",
      "default": false
    },
    "allowed_commands": {
      "type": "array",
      "description": "Narrows what may be run. An empty list allows every command; naming any command forbids the rest.",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "command_aliases": {
      "type": "object",
      "description": "Maps a spelling somebody uses onto the command it means, such as \"app\" onto \"approve\".",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "command_prefix": {
      "type": "string",
      "description": "Opens a slash-style command, as \"/\" does in \"/approve\".",
      "default": "/"
    },
    "disable_bare_commands": {
      "type": "boolean",
      "description": "Stops Smyklot answering an unprefixed word such as \"approve\" or \"lgtm\" on a line of its own.",
      "default": false
    },
    "disable_deleted_comments": {
      "type": "boolean",
      "description": "Stops Smyklot reporting that a comment carrying a command was deleted.",
      "default": false
    },
    "disable_mentions": {
      "type": "boolean",
      "description": "Stops Smyklot answering a mention, such as \"@smyklot approve\".",
      "default": false
    },
    "disable_reactions": {
      "type": "boolean",
      "description": "Stops a reaction on the pull request body counting as a command at all.",
      "default": false
    },
    "disable_unapprove": {
      "type": "boolean",
      "description": "Withdraws the unapprove and disapprove commands.",
      "default": false
    },
    "formatting": {
      "type": "object",
      "description": "Controls file presentation independently of semantic merge. Every dimension defaults to preserve, so adding the feature does not rewrite an existing template.",
      "additionalProperties": false,
      "properties": {
        "common": {
          "type": "object",
          "description": "Carries presentation choices shared by every supported format.",
          "additionalProperties": false,
          "properties": {
            "final_newline": {
              "type": "string",
              "description": "Inserts, removes, or preserves the last line ending.",
              "enum": [
                "preserve",
                "insert",
                "remove"
              ],
              "default": "preserve"
            },
            "indent_style": {
              "type": "string",
              "description": "Chooses spaces, tabs, or the document's existing indentation.",
              "enum": [
                "preserve",
                "spaces",
                "tabs"
              ],
              "default": "preserve"
            },
            "indent_width": {
              "type": "integer",
              "description": "Is the number of spaces represented by one indentation level.",
              "minimum": 1,
              "maximum": 16,
              "default": 2
            },
            "line_ending": {
              "type": "string",
              "description": "Chooses LF, CRLF, or the document's existing endings.",
              "enum": [
                "preserve",
                "lf",
                "crlf"
              ],
              "default": "preserve"
            },
            "line_width": {
              "type": "integer",
              "description": "Is the target width used by automatic collection and prose layout.",
              "minimum": 40,
              "maximum": 320,
              "default": 100
            }
          },
          "default": {
            "final_newline": "preserve",
            "indent_style": "preserve",
            "indent_width": 2,
            "line_ending": "preserve",
            "line_width": 100
          }
        },
        "json": {
          "type": "object",
          "description": "Carries strict JSON presentation choices.",
          "additionalProperties": false,
          "properties": {
            "arrays": {
              "type": "string",
              "description": "Controls JSON array layout.",
              "enum": [
                "preserve",
                "auto",
                "compact",
                "expanded"
              ],
              "default": "preserve"
            },
            "key_order": {
              "type": "string",
              "description": "Preserves insertion order or sorts object keys.",
              "enum": [
                "preserve",
                "sort"
              ],
              "default": "preserve"
            },
            "objects": {
              "type": "string",
              "description": "Controls JSON object layout.",
              "enum": [
                "preserve",
                "auto",
                "compact",
                "expanded"
              ],
              "default": "preserve"
            }
          },
          "default": {
            "arrays": "preserve",
            "key_order": "preserve",
            "objects": "preserve"
          }
        },
        "jsonc": {
          "type": "object",
          "description": "Carries comment-aware JSON presentation choices.",
          "additionalProperties": false,
          "properties": {
            "trailing_commas": {
              "type": "string",
              "description": "Inserts, removes, or preserves JSONC trailing commas.",
              "enum": [
                "preserve",
                "insert",
                "remove"
              ],
              "default": "preserve"
            }
          },
          "default": {
            "trailing_commas": "preserve"
          }
        },
        "markdown": {
          "type": "object",
          "description": "Carries Markdown presentation choices.",
          "additionalProperties": false,
          "properties": {
            "list_spacing": {
              "type": "string",
              "description": "Makes safe lists tight or loose, or preserves their spacing.",
              "enum": [
                "preserve",
                "tight",
                "loose"
              ],
              "default": "preserve"
            },
            "prose_wrap": {
              "type": "string",
              "description": "Wraps safe prose, removes soft wraps, or preserves it.",
              "enum": [
                "preserve",
                "always",
                "never"
              ],
              "default": "preserve"
            },
            "tables": {
              "type": "string",
              "description": "Aligns or compacts safe GFM tables, or preserves them.",
              "enum": [
                "preserve",
                "align",
                "compact"
              ],
              "default": "preserve"
            }
          },
          "default": {
            "list_spacing": "preserve",
            "prose_wrap": "preserve",
            "tables": "preserve"
          }
        },
        "preset": {
          "type": "string",
          "description": "Resets every formatting leaf before sibling overrides are applied.",
          "enum": [
            "preserve",
            "conventional"
          ],
          "default": "preserve"
        },
        "toml": {
          "type": "object",
          "description": "Carries TOML presentation choices.",
          "additionalProperties": false,
          "properties": {
            "align_comments": {
              "type": "string",
              "description": "Aligns or compacts neighbouring TOML comments.",
              "enum": [
                "preserve",
                "align",
                "compact"
              ],
              "default": "preserve"
            },
            "align_entries": {
              "type": "string",
              "description": "Aligns or compacts neighbouring TOML assignments.",
              "enum": [
                "preserve",
                "align",
                "compact"
              ],
              "default": "preserve"
            },
            "arrays": {
              "type": "string",
              "description": "Controls TOML array layout.",
              "enum": [
                "preserve",
                "auto",
                "compact",
                "expanded"
              ],
              "default": "preserve"
            },
            "key_order": {
              "type": "string",
              "description": "Preserves insertion order or sorts TOML keys.",
              "enum": [
                "preserve",
                "sort"
              ],
              "default": "preserve"
            },
            "quote_style": {
              "type": "string",
              "description": "Controls safe TOML string quote preference.",
              "enum": [
                "preserve",
                "prefer_basic",
                "prefer_literal"
              ],
              "default": "preserve"
            },
            "trailing_commas": {
              "type": "string",
              "description": "Controls commas in multiline TOML arrays.",
              "enum": [
                "preserve",
                "multiline",
                "remove"
              ],
              "default": "preserve"
            }
          },
          "default": {
            "align_comments": "preserve",
            "align_entries": "preserve",
            "arrays": "preserve",
            "key_order": "preserve",
            "quote_style": "preserve",
            "trailing_commas": "preserve"
          }
        },
        "yaml": {
          "type": "object",
          "description": "Carries YAML presentation choices.",
          "additionalProperties": false,
          "properties": {
            "document_start": {
              "type": "string",
              "description": "Inserts, removes, or preserves the YAML document marker.",
              "enum": [
                "preserve",
                "insert",
                "remove"
              ],
              "default": "preserve"
            },
            "mappings": {
              "type": "string",
              "description": "Controls YAML mapping layout.",
              "enum": [
                "preserve",
                "auto",
                "flow",
                "block"
              ],
              "default": "preserve"
            },
            "quote_style": {
              "type": "string",
              "description": "Controls safe scalar quote preference.",
              "enum": [
                "preserve",
                "prefer_plain",
                "prefer_single",
                "prefer_double"
              ],
              "default": "preserve"
            },
            "sequence_indent": {
              "type": "string",
              "description": "Controls indentation of block sequence markers.",
              "enum": [
                "preserve",
                "indented",
                "indentless"
              ],
              "default": "preserve"
            },
            "sequences": {
              "type": "string",
              "description": "Controls YAML sequence layout.",
              "enum": [
                "preserve",
                "auto",
                "flow",
                "block"
              ],
              "default": "preserve"
            }
          },
          "default": {
            "document_start": "preserve",
            "mappings": "preserve",
            "quote_style": "preserve",
            "sequence_indent": "preserve",
            "sequences": "preserve"
          }
        }
      },
      "default": {
        "common": {
          "final_newline": "preserve",
          "indent_style": "preserve",
          "indent_width": 2,
          "line_ending": "preserve",
          "line_width": 100
        },
        "json": {
          "arrays": "preserve",
          "key_order": "preserve",
          "objects": "preserve"
        },
        "jsonc": {
          "trailing_commas": "preserve"
        },
        "markdown": {
          "list_spacing": "preserve",
          "prose_wrap": "preserve",
          "tables": "preserve"
        },
        "preset": "preserve",
        "toml": {
          "align_comments": "preserve",
          "align_entries": "preserve",
          "arrays": "preserve",
          "key_order": "preserve",
          "quote_style": "preserve",
          "trailing_commas": "preserve"
        },
        "yaml": {
          "document_start": "preserve",
          "mappings": "preserve",
          "quote_style": "preserve",
          "sequence_indent": "preserve",
          "sequences": "preserve"
        }
      }
    },
    "quiet_pending": {
      "type": "boolean",
      "description": "Drops the comment announcing that a merge is waiting on CI, leaving only its reaction.",
      "default": false
    },
    "quiet_reactions": {
      "type": "boolean",
      "description": "Drops the comment an approval or merge driven by a reaction would post.",
      "default": false
    },
    "quiet_success": {
      "type": "boolean",
      "description": "Drops the comment a successful command would post, leaving only its reaction. Errors and warnings still comment.",
      "default": false
    },
    "runner": {
      "type": "string",
      "description": "Names the entry point that acts on this repository, so the other one stands down. It is settable only in the repository's own file: the panel cannot write it, because a repository that has moved back to the Action must be able to say so itself.",
      "enum": [
        "service",
        "action"
      ],
      "default": "service"
    }
  }
}
