/target
.idea
tmp
bin/
.task/

# The dev mock server keeps your panel preferences here so a restart does not reset them.
internal/panel/frontend/dev/.mock-preferences.json

# Guard against a probe script writing screenshots here when its output path is unset.
internal/panel/frontend/undefined/

# Vitest writes a cache here when it is run from the repo root rather than the frontend.
# No trailing slash: that would match directories only, and a symlinked node_modules is a
# symlink as far as git is concerned, not a directory.
node_modules
