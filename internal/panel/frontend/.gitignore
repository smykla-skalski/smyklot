dist/
node_modules
# `svelte-kit sync` regenerates this on every install and build, and the tsconfig
# the type checker reads lives inside it - so it has to exist locally and must
# never be committed.
.svelte-kit/
.smyklot-panel-install.lock/
.smyklot-panel-install.lock.stale-*

# Generated by `svelte-kit sync`, which the `prepare` script runs on every
# install. It holds the generated types and the resolved route tree, so it is
# rebuilt from the source beside it and never worth a diff.
.svelte-kit/
