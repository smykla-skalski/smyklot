{
  "name": "smyklot-panel-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:mock": "SMYKLOT_PANEL_DEV_MOCK=1 vite",
    "lint": "eslint . && prettier --check . && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker/tsconfig.json",
    "format": "prettier --write .",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "prepare": "svelte-kit sync",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "storybook": "SMYKLOT_PANEL_DEV_MOCK=1 storybook dev -p 6008 --no-open",
    "storybook:build": "SMYKLOT_PANEL_DEV_MOCK=1 storybook build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-mcp": "10.6.0",
    "@storybook/addon-svelte-csf": "5.1.3",
    "@storybook/sveltekit": "10.6.0",
    "@sveltejs/adapter-static": "4.0.0-next.4",
    "@sveltejs/kit": "3.0.0-next.25",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "csstype": "3.2.3",
    "eslint": "10.9.1",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "playwright-core": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "storybook": "10.6.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/svelte-query": "^6.1.38",
    "bits-ui": "^2.18.1",
    "jsonc-parser": "^3.3.1",
    "layerchart": "^2.4.0",
    "runed": "^0.37.1"
  },
  "overrides": {
    "runed": {
      "@sveltejs/kit": "$@sveltejs/kit"
    },
    "valibot": "^1.4.2"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
