{
  "name": "smyklot-panel-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:mock": "SMYKLOT_PANEL_DEV_MOCK=1 vite",
    "lint": "eslint . && prettier --check . && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "test": "vitest run",
    "prepare": "svelte-kit sync",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "csstype": "3.2.3",
    "eslint": "10.8.1",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "playwright-core": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.1.38",
    "@tanstack/svelte-table": "9.1.2",
    "@tanstack/svelte-virtual": "3.13.35",
    "bits-ui": "^2.18.1",
    "runed": "^0.37.1"
  }
}
