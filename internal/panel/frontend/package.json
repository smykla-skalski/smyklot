{
  "name": "smyklot-panel-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:mock": "SMYKLOT_PANEL_DEV_MOCK=1 vite",
    "lint": "eslint . && prettier --check . && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.8.1",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
